<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.personalexpensemanager.controller.MainController">

  <top>
    <VBox spacing="6.0" style="-fx-background-color: #1f2933;">
      <padding>
        <Insets bottom="14.0" left="20.0" right="20.0" top="14.0"/>
      </padding>
      <Label text="Quản lý chi tiêu cá nhân"
             style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
      <HBox spacing="28.0">
        <Label fx:id="summaryLabel" style="-fx-text-fill: #cbd2d9;"/>
        <Label fx:id="totalBalanceLabel" style="-fx-text-fill: #7bdff2; -fx-font-weight: bold;"/>
      </HBox>
    </VBox>
  </top>

  <left>
    <VBox prefWidth="290.0" spacing="10.0">
      <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
      </padding>
      <Label text="Ví của bạn" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
      <ListView fx:id="walletList" VBox.vgrow="ALWAYS"/>

      <Separator/>

      <Label text="Thêm ví mới" style="-fx-font-weight: bold;"/>
      <TextField fx:id="walletNameField" promptText="Tên ví"/>
      <ComboBox fx:id="walletTypeBox" maxWidth="Infinity"/>
      <TextField fx:id="walletBalanceField" promptText="Số dư ban đầu (để trống là 0)"/>
      <Button fx:id="addWalletButton" text="Thêm ví" maxWidth="Infinity"
              onAction="#handleAddWallet"/>
    </VBox>
  </left>

  <center>
    <VBox spacing="10.0">
      <padding>
        <Insets bottom="16.0" left="0.0" right="16.0" top="16.0"/>
      </padding>
      <HBox spacing="10.0">
        <TextField fx:id="searchField" HBox.hgrow="ALWAYS"
                   promptText="Tìm theo mã, ghi chú, danh mục hoặc tên ví..."/>
        <Button fx:id="exportReportButton" text="Xuất báo cáo tháng"
                onAction="#handleExportReport"/>
        <Button fx:id="deleteButton" text="Xoá giao dịch đã chọn"
                onAction="#handleDeleteTransaction"/>
      </HBox>

      <TableView fx:id="transactionTable" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="dateColumn" text="Ngày" prefWidth="100.0"/>
          <TableColumn fx:id="typeColumn" text="Loại" prefWidth="70.0"/>
          <TableColumn fx:id="categoryColumn" text="Danh mục" prefWidth="140.0"/>
          <TableColumn fx:id="amountColumn" text="Số tiền (VND)" prefWidth="130.0"
                       style="-fx-alignment: CENTER-RIGHT;"/>
          <TableColumn fx:id="walletColumn" text="Ví" prefWidth="140.0"/>
          <TableColumn fx:id="noteColumn" text="Ghi chú" prefWidth="200.0"/>
        </columns>
        <columnResizePolicy>
          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
      </TableView>
    </VBox>
  </center>

  <bottom>
    <VBox spacing="8.0" style="-fx-background-color: #f5f7fa;">
      <padding>
        <Insets bottom="14.0" left="16.0" right="16.0" top="14.0"/>
      </padding>
      <Label text="Ghi một giao dịch mới" style="-fx-font-weight: bold;"/>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
        <ComboBox fx:id="typeBox" prefWidth="110.0"/>
        <TextField fx:id="amountField" prefWidth="130.0" promptText="Số tiền"/>
        <DatePicker fx:id="datePicker" prefWidth="150.0"/>
        <ComboBox fx:id="categoryBox" prefWidth="160.0"/>
        <ComboBox fx:id="walletBox" prefWidth="180.0"/>
        <TextField fx:id="detailField" prefWidth="170.0"/>
        <TextField fx:id="noteField" HBox.hgrow="ALWAYS" promptText="Ghi chú"/>
        <Button fx:id="addTransactionButton" text="Thêm giao dịch" defaultButton="true"
                onAction="#handleAddTransaction"/>
      </HBox>
      <Label fx:id="statusLabel"/>
    </VBox>
  </bottom>
</BorderPane>
